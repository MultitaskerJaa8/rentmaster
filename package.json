{
  "name": "rentmaster",
  "version": "1.0.0",
  "private": true,
  "description": "Real-Time Property Rental, Maintenance & Amenity Management Platform",
  "main": "server/server.js",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "server": "nodemon server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n SERVER,CLIENT -c blue,magenta \"npm run server\" \"npm run client\"",
    "start": "node server/server.js",
    "seed": "node seed.js",
    "seed:destroy": "node seed.js --destroy",
    "install-client": "npm install --prefix client",
    "build": "npm install --prefix client && npm run build --prefix client",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4"
  }
}